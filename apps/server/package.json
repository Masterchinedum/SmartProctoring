{
  "name": "@sp/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/scripts/seed.ts",
    "eval:identity": "tsx src/eval/identity-eval-cli.ts",
    "retention:run": "tsx src/scripts/retention-cli.ts"
  },
  "dependencies": {
    "@sp/shared": "workspace:*",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "onnxruntime-node": "^1.22.0",
    "pg": "^8.16.3",
    "piscina": "^5.1.3",
    "pino": "^9.9.0",
    "sharp": "^0.34.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
