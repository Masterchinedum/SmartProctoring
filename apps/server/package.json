{
  "name": "@sp/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "start:vision-worker": "node dist/vision-server.js",
    "vision-worker": "tsx src/vision-worker/main.ts",
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "seed": "tsx src/scripts/seed.ts",
    "eval:identity": "tsx src/eval/identity-eval-cli.ts",
    "eval:fetch-faces": "tsx src/eval/fetch-facesets-cli.ts",
    "retention:run": "tsx src/scripts/retention-cli.ts",
    "rekey": "tsx src/scripts/rekey-cli.ts",
    "storage:move": "tsx src/scripts/storage-move-cli.ts",
    "staff-access": "tsx src/scripts/staff-access-cli.ts",
    "openapi": "tsx src/scripts/openapi-cli.ts"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1139.0",
    "@aws-sdk/client-s3": "^3.1139.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.4",
    "@fastify/websocket": "^11.2.0",
    "@prometheus-io/client": "^0.16.1",
    "@sp/shared": "workspace:*",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.6.0",
    "ioredis": "^5.7.0",
    "nodemailer": "^10.0.10",
    "onnxruntime-node": "^1.22.0",
    "pg": "^8.16.3",
    "pino": "^9.9.0",
    "sharp": "^0.35.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^0.31.4",
    "pino-pretty": "^13.1.1",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "ws": "^8.21.3"
  }
}
