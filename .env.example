# ---- SmartProctoring server configuration ----
NODE_ENV=production
PORT=8080
# Public origin candidates and staff use (used to build candidate access links)
PUBLIC_URL=https://proctor.example.com
# Behind a reverse proxy / load balancer that terminates TLS: list the PROXY addresses/CIDRs to trust
# (never `true`: that trusts client-supplied X-Forwarded-For and defeats rate limits / audit IPs).
# Examples: loopback | 10.0.0.0/8 | loopback,uniquelocal   (docker compose default network: uniquelocal)
TRUST_PROXY=loopback,uniquelocal
COOKIE_SECURE=true

# docker compose builds DATABASE_URL from POSTGRES_PASSWORD; set DATABASE_URL yourself otherwise
POSTGRES_PASSWORD=
DATABASE_URL=postgres://proctor:<password>@postgres:5432/proctor

# 32 random bytes, base64. Generate with:  openssl rand -base64 32
# Encrypts screenshots, identity references and face templates at rest. Keep it in a secret manager.
EVIDENCE_KEY=
# Comma-separated previous keys (base64) still accepted for decryption during key rotation
EVIDENCE_KEYS_OLD=
# Signs staff session cookies. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Evidence storage: fs (local volume) or s3 (any S3-compatible object store)
STORAGE_DRIVER=fs
STORAGE_DIR=/data/evidence
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Optional: enables realtime fan-out across multiple server instances
# REDIS_URL=redis://redis:6379

# First start only: creates the organisation owner if no staff users exist
BOOTSTRAP_ADMIN_EMAIL=owner@example.com
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ORG_NAME=Example University

# ---- Integrations (optional; see docs/INTEGRATION_API.md and docs/OPERATIONS.md §8)
# Email alerts to staff (Settings → Integrations). Leave SMTP_HOST unset to disable email alerts.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# true = implicit TLS (usually port 465); false = STARTTLS when the server offers it (587/25)
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="SmartProctoring <proctoring-alerts@example.com>"
# Webhooks may only target public https:// addresses in production (SSRF protection).
# DEVELOPMENT ONLY: allow http:// and receivers on localhost / private networks. Never true in production.
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
# Disable a webhook after this many consecutive failed attempts (spanning at least one hour)
# WEBHOOK_DISABLE_AFTER_FAILURES=20
# Integration API (/api/v1) requests per minute per API key
# API_RATE_LIMIT_PER_MINUTE=600

# Optional overrides
# MODELS_DIR=/app/apps/server/models
# WEB_DIST_DIR=/app/apps/web/dist
# VISION_CONCURRENCY=4
LOG_LEVEL=info
